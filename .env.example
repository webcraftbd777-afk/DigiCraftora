# Copy to .env.local for local development. Names only; never commit real values.
NEXT_PUBLIC_SITE_URL=https://digicraftora.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only for `npm test` integration tests. Must point to a SEPARATE test project, never production.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
