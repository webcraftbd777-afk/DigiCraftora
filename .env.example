# =====================================================================
# DigiCraftora Website - Environment Configuration Example
# Copy this file to .env before starting: cp .env.example .env
# =====================================================================

# Server Port (default: 3000)
PORT=3000
NODE_ENV=development

# Public Application URL
APP_URL=http://localhost:3000

# Optional: Gemini API Key (for server-side AI capabilities if enabled)
GEMINI_API_KEY=

# Optional: WhatsApp Cloud API Credentials (for real SMS/WhatsApp webhook relay)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# FOUNDER_WHATSAPP_PHONE=+917427979100
# FOUNDER_ALERT_EMAIL=webcraftbd777@gmail.com
